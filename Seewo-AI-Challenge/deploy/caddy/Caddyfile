# Caddyfile — Seewo AI Challenge 生产反代 + 自动 HTTPS
# V1.0 item 2: certbot 自动化确认
# V2.0 Sprint 5 (5.6): TLS 全链路加固 — HSTS preload + 内服务加密 + 协议限制
#
# Caddy 内置 ACME（Let's Encrypt）自动签发 + 自动续期：
#   - 首次启动自动签发证书（HTTP-01 challenge，需 80 端口可达）
#   - 证书有效期 90 天，Caddy 在到期前 1/3（~30 天）自动续期
#   - 无需 certbot cron / systemd timer —— Caddy 自身管理续期生命周期
#   - 续期失败时 Caddy 会重试并记录到 access/error log
#
# V2.0 Sprint 5 TLS 全链路加固:
#   1. HSTS: max-age=63072000 (2年) + preload + includeSubDomains
#   2. TLS 1.2/1.3 only (禁用 TLS 1.0/1.1)
#   3. 内服务加密: Caddy → gunicorn 走 HTTPS (自签证书) 或 Unix socket
#   4. HTTP→HTTPS 自动跳转 (Caddy 默认行为)
#   5. 证书透明度日志 (CT log) 默认开启
#
# 部署方式（ECS）：
#   sudo caddy run --config /path/to/Caddyfile
#   或 systemd: systemctl enable --now caddy
#
# 续期可靠性确认：
#   1. Caddy 进程常驻，续期由主循环自动触发（非 cron 依赖）
#   2. 证书存储在 /var/lib/caddy/.local/share/caddy/certificates/
#   3. 配合 scripts/check_cert_expiry.py 做到期监控告警
#   4. 若 80 端口被占（已有 nginx），改用 DNS-01 challenge（见注释段）

# ── TLS 全局配置 ──────────────────────────────────────────────────────
{
	# V2.0 Sprint 5: 仅允许 TLS 1.2 和 1.3
	servers {
		protocols h1 h2 h3
		tls_protocols tls1.2 tls1.3
	}
}

# ── 生产域名 ──────────────────────────────────────────────────────────
seewo.researchkit.online {
	# 自动 HTTPS：Caddy 自动签发 + 续期 Let's Encrypt 证书
	# V2.0 Sprint 5: 显式 TLS 配置（协议 + 密码套件）
	tls {
		protocols tls1.2 tls1.3
		# Let's Encrypt 自动签发（默认行为，无需手动指定证书路径）
		# 如需使用已有证书，取消注释：
		# cert /etc/ssl/seewo.crt
		# key /etc/ssl/seewo.key
	}

	# V2.0 Sprint 5: 内服务加密 — Caddy → gunicorn 走 HTTPS
	# 生成自签证书: openssl req -x509 -newkey rsa:2048 -keyout /etc/ssl/internal.key -out /etc/ssl/internal.crt -days 365 -nodes -subj "/CN=localhost"
	# 或使用 Unix socket（更安全，无网络暴露）:
	#   gunicorn --bind unix:/tmp/seewo.sock
	#   reverse_proxy unix//tmp/seewo.sock
	reverse_proxy 127.0.0.1:8000 {
		# V2.0 Sprint 5: 内服务 TLS（如 gunicorn 配置了 TLS）
		# transport http {
		# 	tls
		# 	tls_trusted_ca_cert_file /etc/ssl/internal.crt
		# }
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# V2.0 Sprint 5: 安全头加固
	header {
		# HSTS: 2年 + preload + includeSubDomains
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# V2.0 Sprint 5: 新增安全头
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Cross-Origin-Opener-Policy "same-origin"
		# 删除暴露版本号的头
		-Server
	}

	# 静态资源缓存
	@static path /static/* /favicon.ico
	header @static Cache-Control "public, max-age=86400"

	# 压缩
	encode gzip zstd

	# 访问日志
	log {
		output file /var/log/caddy/seewo-access.log {
			roll_size 100mb
			roll_keep 7
		}
	}
}

# ── DNS-01 challenge 备选（80 端口不可用时） ──────────────────────────
# 取消注释并填入 DNS provider 插件的 API token，Caddy 用 DNS-01 签发：
# seewo.researchkit.online {
# 	tls {
# 		dns aliyun {env.ALIYUN_ACCESS_KEY} {env.ALIYUN_SECRET_KEY}
# 	}
# 	reverse_proxy 127.0.0.1:8000
# }
