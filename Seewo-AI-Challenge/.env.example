# Phase 1 .env.example (Week 2 — P0-7)
#
# ⚠️  禁止把真实密钥提交到仓库。所有值为占位符，启动期 config.py 会校验。
# 生成强随机密钥：openssl rand -hex 32
#
# 必填项（生产环境强制）：FLASK_SECRET_KEY（≥32 字节）、LLM_API_KEY

# 运行环境：development / staging / production / test
# production 触发 P0-2 model_validator 严格校验 + C-08 LLM 校验
# test 用于 pytest，绕过生产校验
ENV=development

# Flask session 签名密钥（必填，生产环境 ≥ 32 字节且不能是默认占位符）
FLASK_SECRET_KEY=

# 日志级别
LOG_LEVEL=INFO

# 数据库（开发用本地默认；生产通过 docker-compose.prod.yml 覆盖）
DATABASE_URL=postgresql+asyncpg://seewo:seewo@localhost:5432/seewo
DATABASE_URL_SYNC=postgresql+psycopg2://seewo:seewo@localhost:5432/seewo

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Demo 模式守门（队长 P0 条件）
# production 必须为 false；dev/staging 可为 true 走 demo 演示账号
SEEWO_DEMO_MODE=false

# ——— C-08 LLM 配置（C-08 返工后）———
# provider 选择由 engine.llm.factory.get_provider() 完成，**唯一配置源是环境变量**。
#   LLM_API_KEY 未设   → MockProvider（规则引擎兜底，demo 默认）
#   LLM_API_KEY 已设 + LLM_MODEL=deepseek-math → DeepSeekProvider
#   LLM_API_KEY 已设 + LLM_MODEL=其他值        → OpenAIProvider（OpenAI 兼容协议）
# config.py 的 LLM 字段仅做 Pydantic 强校验层，不参与 provider 选择（避免双配置源）。
#
# DeepSeek-Math 真模型路径（C-08 主路径）：
#   LLM_API_KEY=sk-...                  # DeepSeek 控制台 key（⚠️ 勿贴评论/文档，走安全渠道）
#   LLM_BASE_URL=                        # 留空默认 https://api.deepseek.com/v1；私有部署填实际地址
#   LLM_MODEL=deepseek-math              # 逻辑名：触发 DeepSeekProvider 分发 + trace model 字段
#   LLM_API_MODEL=deepseek-v4-pro        # 必填：上游真实模型 id（忘设→400→降级 mock→假绿，eval 会判 INVALID）
#   LLM_TIMEOUT=60                       # 默认 60s，DeepSeek 推理较 OpenAI 慢
#   LLM_MAX_RETRIES=1                    # 失败重试 1 次，再失败降级 MockProvider
#
# OpenAI 兼容路径示例：
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
