# ═══════════════════════════════════════════════════════════════════════
#  Seewo AI Challenge — Demo 环境变量模板
#  复制为 .env 后按需填；.env 已在 .gitignore 里
# ═══════════════════════════════════════════════════════════════════════

# ── Flask 必需 ────────────────────────────────────────────────────────
# 部署前必须改！可用 `python -c "import secrets; print(secrets.token_hex(32))"` 生成
SECRET_KEY=change-me-please-generate-a-random-64-char-string

# 留空 = development 模式（带 reload + debug）
# production = 关 debug，等价于 gunicorn 跑
FLASK_ENV=production

# ── LLM（可选 — 留空自动走 MockProvider 降级路径）────────────────
# DeepSeek 兼容 OpenAI 协议；OpenAI / 智谱 / 月之暗面只需改 LLM_BASE_URL + LLM_MODEL
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── 演示账号（与 demo/tests/conftest.py DEMO_ACCOUNTS 完全一致）────
# leader 集成时把这 8 个账号硬编进 engine.auth 即可
# teacher / teacher123
# head   / head123
# admin  / admin123
# s01~s05 / student123

# ── Gunicorn 调优（Docker 内部使用，本机直接 `python app.py` 忽略）──
GUNICORN_BIND=0.0.0.0:5000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30
GUNICORN_LOGLEVEL=info
